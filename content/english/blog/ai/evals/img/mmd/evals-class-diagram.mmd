classDiagram
%% Types below are Python annotations written for this diagram. The evalkit
%% source itself is not in this repository, so member names and relationships
%% come from the class reference in evals.md and the types are annotations added
%% here, not a transcription of shipped code.
%%
%% Dunder members use markdown escapes (+\_\_len\_\_) because mermaid runs
%% class labels through markdown: unescaped __name__ renders as bold "name"
%% with both underscore pairs eaten.
%%
%% Render: npx -p @mermaid-js/mermaid-cli mmdc -i <this file> -o <file>.png \
%%   -b white --scale 16
%% Scale 16, not the documented default 8: this diagram is twice as wide as the
%% untyped one, so scale 8 renders at 0.37 px/unit against the 0.77 px/unit of
%% the previously committed PNG and halves label size.
%% ===== Core types =====
class ScoreType:::core {
    <<enumeration>>
    BINARY
    NUMERIC
    LIKERT
    CATEGORICAL
}
class EvalCase:::core {
    +input: str
    +expected: str | None
    +metadata: dict[str, str]
    +tags: list[str]
}
class EvalResult:::core {
    +case: EvalCase
    +output: str
    +scores: list[ScoreResult]
    +passed: bool
    +metadata: dict[str, Any]
    +latency_ms: float
    +error: str | None
}
class EvalReport:::core {
    +name: str
    +results: list[EvalResult]
    +total: int
    +passed: int
    +failed: int
    +pass_rate: float
    +avg_scores: dict[str, float]
    +avg_latency_ms: float
    +\_\_post_init\_\_() None
    +summary() str
}
class EvalConfig:::core {
    +project_name: str
    +pass_threshold: float
    +regression_tolerance: float
    +ensure_dirs() None
}
class Dataset:::core {
    +name: str
    +cases: list[EvalCase]
    +\_\_len\_\_() int
    +\_\_iter\_\_() Iterator[EvalCase]
    +\_\_getitem\_\_(index: int) EvalCase
    +filter_by_tag(tag: str) Dataset
    +sample(n: int, seed: int | None) Dataset
    +from_json(path: str) Dataset
    +from_jsonl(path: str) Dataset
    +to_json(path: str | None) str
    +stats() dict[str, Any]
}
class ScoreResult:::core {
    +name: str
    +score: float
    +passed: bool
    +reason: str
    +raw_value: Any
}
EvalReport o-- EvalResult
EvalResult o-- EvalCase
Dataset o-- EvalCase

%% ===== Scorers =====
class Scorer:::scorer {
    <<abstract>>
    +name: str
    +score_type: ScoreType
    +threshold: float
    +score(output: str, expected: str | None) ScoreResult
    +score_batch(outputs: list[str], expecteds: list[str]) list[ScoreResult]
}
class ExactMatch:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class Contains:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class RegexMatch:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class AllOf:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class AnyOf:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class ContainsAll:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class ContainsAny:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class JsonMatch:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class LevenshteinSimilarity:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    -_levenshtein_distance(a: str, b: str) int
}
class JsonSchemaValid:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    -_validate(instance: Any, schema: dict[str, Any]) bool
}
class EmbeddingSimilarity:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    +score_batch(outputs: list[str], expecteds: list[str]) list[ScoreResult]
    -_get_embeddings(texts: list[str]) list[list[float]]
    -_cosine_similarity(a: list[float], b: list[float]) float
}
class LengthRange:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class NoForbiddenContent:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class PythonSyntaxValid:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    -_extract_python(text: str) str
}
class SqlSyntaxValid:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class ContextRelevance:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    -_judge_chunk(query: str, chunk: str) ScoreResult
}
class Faithfulness:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    -_extract_claims(answer: str) list[str]
    -_verify_claim(claim: str, contexts: list[str]) bool
}
class AnswerCompleteness:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class ContextRecall:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    -_text_overlap(answer: str, contexts: list[str]) float
}
class ToolCallCorrectness:::scorer {
    +score(output: str, expected: str | None) ScoreResult
    -_lcs_length(actual: list[str], expected: list[str]) int
}
class TrajectoryEfficiency:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class MultiTurnCoherence:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class TaskCompletion:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class CachedScorer:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}
class LangfuseScorer:::scorer {
    +score(output: str, expected: str | None) ScoreResult
}

Scorer <|-- ExactMatch
Scorer <|-- Contains
Scorer <|-- RegexMatch
Scorer <|-- AllOf
Scorer <|-- AnyOf
Scorer <|-- ContainsAll
Scorer <|-- ContainsAny
Scorer <|-- JsonMatch
Scorer <|-- LevenshteinSimilarity
Scorer <|-- JsonSchemaValid
Scorer <|-- EmbeddingSimilarity
Scorer <|-- LengthRange
Scorer <|-- NoForbiddenContent
Scorer <|-- PythonSyntaxValid
Scorer <|-- SqlSyntaxValid
Scorer <|-- LLMJudge
Scorer <|-- LengthNormalizedJudge
Scorer <|-- ConsensusJudge
Scorer <|-- ContextRelevance
Scorer <|-- Faithfulness
Scorer <|-- AnswerCompleteness
Scorer <|-- ContextRecall
Scorer <|-- ToolCallCorrectness
Scorer <|-- TrajectoryEfficiency
Scorer <|-- MultiTurnCoherence
Scorer <|-- TaskCompletion
Scorer <|-- CachedScorer
Scorer <|-- LangfuseScorer
AllOf o-- Scorer : combines
AnyOf o-- Scorer : combines
Scorer ..> ScoreResult : returns
Scorer ..> ScoreType : score_type

class ScorerCache:::scorer {
    -_dir: Path
    -_hits: int
    -_misses: int
    -_key(scorer_name: str, payload: str) str
    +get(key: str) ScoreResult | None
    +set(key: str, value: ScoreResult) None
    +hit_rate() float
}
CachedScorer o-- Scorer : wraps
CachedScorer --> ScorerCache
ScorerCache ..> ScoreResult

%% ===== Judge / calibration =====
class JudgeCriterion:::judge {
    +name: str
    +description: str
    +weight: float
    +scale: str
}
class JudgeConfig:::judge {
    +model: str
    +temperature: float
    +max_tokens: int
    +criteria: list[JudgeCriterion]
    +system_prompt: str
    +pass_score: float
}
class CalibrationCase:::judge {
    +case_id: str
    +task_input: str
    +human_score: float
    +judge_score: float
    +output: str
}
class LLMJudge:::judge {
    +score(output: str, expected: str | None) ScoreResult
    -_build_prompt(output: str, expected: str | None) str
    -_parse_response(response: str) ScoreResult
}
class LengthNormalizedJudge:::judge {
    +score(output: str, expected: str | None) ScoreResult
}
class ConsensusJudge:::judge {
    +score(output: str, expected: str | None) ScoreResult
}
LLMJudge --> JudgeConfig
LengthNormalizedJudge o-- LLMJudge : wraps
ConsensusJudge *-- LLMJudge : builds one per config
ConsensusJudge ..> JudgeConfig
JudgeConfig o-- JudgeCriterion

%% ===== Guardrails =====
class Guardrail:::guardrail {
    +check(output: str) GuardrailResult
}
class ProfanityGuardrail:::guardrail {
    +check(output: str) GuardrailResult
}
class LengthGuardrail:::guardrail {
    +check(output: str) GuardrailResult
}
class PIIGuardrail:::guardrail {
    +check(output: str) GuardrailResult
}
class GuardrailResult:::guardrail {
    +passed: bool
    +guardrail_name: str
    +action: str
    +reason: str
    +latency_ms: float
    +original_output: str
    +modified_output: str
}
class GuardrailPipeline:::guardrail {
    +run(output: str) PipelineResult
}
class PipelineResult:::guardrail {
    +final_output: str
    +blocked: bool
    +guardrail_results: list[GuardrailResult]
    +total_latency_ms: float
}
Guardrail <|-- ProfanityGuardrail
Guardrail <|-- LengthGuardrail
Guardrail <|-- PIIGuardrail
Guardrail ..> GuardrailResult : returns
GuardrailPipeline o-- Guardrail
GuardrailPipeline --> PipelineResult
PipelineResult o-- GuardrailResult

%% ===== Execution / runners =====
class Runner:::runner {
    +system: Callable
    +scorers: list[Scorer]
    +pass_threshold: float
    +run_case(case: EvalCase) EvalResult
    +run(dataset: Dataset) EvalReport
}
class CostAwareRunner:::runner {
    +system: Callable
    +scorers: list[Scorer]
    +budget: float
    +pass_threshold: float
    +cost_report: CostReport
    +run(dataset: Dataset) EvalReport
}
class TieredRunner:::runner {
    +system: Callable
    +fast_scorers: list[Scorer]
    +slow_scorers: list[Scorer]
    -_threshold: float
    +run_case(case: EvalCase) EvalResult
    +run(dataset: Dataset) EvalReport
}
class ConcurrentRunner:::runner {
    +system: Callable
    +scorers: list[Scorer]
    +pass_threshold: float
    -_semaphore_limit: int
    -_run_case_async(case: EvalCase) EvalResult
    +run(dataset: Dataset) EvalReport
    -_run_all(cases: list[EvalCase]) list[EvalResult]
}
class CostEntry:::runner {
    +scorer_name: str
    +model: str
    +input_tokens: int
    +output_tokens: int
    +estimated_cost: float
    +case_id: str
}
class CostReport:::runner {
    +entries: list[CostEntry]
    +total_cost() float
    +total_input_tokens() int
    +total_output_tokens() int
    +cost_by_scorer() dict[str, float]
    +cost_by_model() dict[str, float]
    +summary() str
}
Runner --> Dataset
Runner o-- Scorer
Runner --> EvalReport
Runner ..> EvalResult : returns
%% NOTE: inheritance below is NOT in the book's code (these are standalone classes there);
%% shown here as the conceptual "extends Runner" relationship the book's prose describes.
%% Scorer/Dataset/EvalReport links are inherited from Runner, so not repeated.
Runner <|-- CostAwareRunner
Runner <|-- TieredRunner
Runner <|-- ConcurrentRunner
CostAwareRunner --> CostReport
CostReport o-- CostEntry

%% ===== Datasets & versioning =====
class DatasetVersion:::dataset {
    +version: str
    +name: str
    +case_count: int
    +checksum: str
    +created_at: datetime
    +changelog: str
}
class DatasetRegistry:::dataset {
    -_load_manifest() dict[str, Any]
    -_save_manifest(manifest: dict[str, Any]) None
    -_checksum(cases: list[EvalCase]) str
    +register(dataset: Dataset, changelog: str) DatasetVersion
    +load(name: str) Dataset
    +history(name: str) list[DatasetVersion]
}
class SyntheticGenerator:::dataset {
    +generate(count: int, difficulty: str) Dataset
}
class ValidationIssue:::dataset {
    +severity: str
    +case_index: int
    +message: str
}
DatasetRegistry o-- DatasetVersion
DatasetRegistry --> Dataset
SyntheticGenerator ..> EvalCase : generates

%% ===== Regression & prompts =====
class RegressionResult:::regression {
    +is_regression: bool
    +overall_delta: float
    +metric_deltas: dict[str, float]
    +new_failures: list[str]
    +new_passes: list[str]
    +message: str
}
class RegressionDetector:::regression {
    +golden_path: Path
    +tolerance: float
    +save_baseline(report: EvalReport) Path
    +compare(current: EvalReport) RegressionResult
}
class PromptComparisonResult:::regression {
    +prompt_a_name: str
    +prompt_b_name: str
    +report_a: EvalReport
    +report_b: EvalReport
    +winner: str
    +metrics_comparison: dict[str, Any]
}
class PromptVersion:::regression {
    +version: str
    +content: str
    +created_at: datetime
    +author: str
    +eval_pass_rate: float
}
class PromptRegistry:::regression {
    -_load() dict[str, PromptVersion]
    -_save(versions: dict[str, PromptVersion]) None
    +register(content: str, author: str) PromptVersion
    +load(name: str | None) PromptVersion
    +history() list[PromptVersion]
}
RegressionDetector --> RegressionResult
RegressionDetector --> EvalReport
PromptComparisonResult o-- EvalReport
PromptRegistry o-- PromptVersion

%% ===== RAG =====
class RAGCase:::rag {
    +query: str
    +retrieved_contexts: list[str]
    +generated_answer: str
    +expected_answer: str
    +ground_truth_contexts: list[str]
}

%% ===== Agents =====
class ToolCall:::agent {
    +tool_name: str
