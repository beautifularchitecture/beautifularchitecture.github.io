AnnotationBatch o-- AnnotationTask
AnnotationBatch o-- Annotation

%% ===== Production monitoring =====
class SampledRequest:::monitor {
    +request_id: str
    +input: str
    +output: str
    +timestamp: datetime
    +scores: list[ScoreResult]
}
class ProductionSampler:::monitor {
    -_rate: float
    -_scorers: list[Scorer]
    -_buffer: list[SampledRequest]
    +should_sample() bool
    +evaluate_sample(request: SampledRequest) SampledRequest
    +flush() list[SampledRequest]
    +stats() dict[str, Any]
}
class QualityWindow:::monitor {
    +window_start: datetime
    +window_end: datetime
    +sample_count: int
    +avg_scores: dict[str, float]
    +pass_rate: float
    +alert_triggered: bool
    +alert_message: str
}
class QualityMonitor:::monitor {
    -_thresholds: dict[str, float]
    -_min_samples: int
    -_windows: list[QualityWindow]
    +process_window(samples: list[SampledRequest]) QualityWindow
    +trend() dict[str, float]
}
ProductionSampler o-- Scorer
ProductionSampler --> SampledRequest
QualityMonitor o-- QualityWindow
QualityMonitor --> SampledRequest

%% ===== Integrations & workflows =====
class EvalKitToDeepEvalMetric:::misc {
    +\_\_name\_\_: str
    +measure(test_case: Any) float
    +is_successful() bool
}
class ExperimentRecord:::misc {
    +experiment_id: str
    +description: str
    +prompt_version: str
    +model: str
    +pass_rate: float
    +avg_scores: dict[str, float]
    +regression: RegressionResult
    +timestamp: datetime
}
class EDDWorkflow:::misc {
    +dataset: Dataset
    +scorers: list[Scorer]
    +detector: RegressionDetector
    -_load_history() list[ExperimentRecord]
    -_save_history(history: list[ExperimentRecord]) None
    +run_experiment(model: str, prompt_version: str) ExperimentRecord
    +print_history() None
    +best_experiment() ExperimentRecord
}
class SupportBot:::misc {
    +system_prompt: str
    +model: str
    +handle(message: str) str
    -_execute_tool(name: str, arguments: dict[str, Any]) str
}
EvalKitToDeepEvalMetric o-- Scorer : wraps
LangfuseScorer o-- Scorer : wraps
EDDWorkflow o-- Dataset
EDDWorkflow o-- Scorer
EDDWorkflow *-- RegressionDetector
EDDWorkflow o-- ExperimentRecord

