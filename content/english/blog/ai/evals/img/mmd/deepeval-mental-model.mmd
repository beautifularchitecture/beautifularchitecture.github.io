flowchart LR
    %% DeepEval v4.2.8 mental model.
    %% Class names verified against the released deepeval 4.2.8 wheel and deepeval.com/docs.
    %% Rendered with @mermaid-js/mermaid-cli.

    subgraph GEN["Data generation (optional)"]
        direction TB
        SYN["Synthesizer"]
        SIM["ConversationSimulator"]
    end

    subgraph DATA["Goldens (inputs)"]
        direction TB
        A["Golden<br>input + expected_output"]
        CG["ConversationalGolden<br>scenario + persona"]
        ED["EvaluationDataset<br>holds many goldens"]
    end

    B["App executes<br>LLM / agent / RAG"]
    OBS["@observe<br>Trace + BaseSpan"]

    subgraph TC["Test cases"]
        direction TB
        C["LLMTestCase<br>input + actual_output + ..."]
        CTC["ConversationalTestCase<br>turns: list[Turn]"]
        ATC["ArenaTestCase<br>contestants: list[Contestant]"]
    end

    subgraph MET["Metrics (each carries a threshold)"]
        direction TB
        BM["BaseMetric<br>single-turn"]
        BCM["BaseConversationalMetric<br>multi-turn"]
        BVM["BaseVoiceMetric<br>voice"]
        BAM["BaseArenaMetric<br>arena"]
        CLS["Classifier<br>categorical"]
    end

    JUDGE["LLM judge<br>DeepEvalBaseLLM"]
    E["Score 0–1 + reason<br>is_successful()"]
    F["Pass / Fail"]
    WIN["Winner label"]

    subgraph RUN["Runners"]
        direction TB
        EV["evaluate() / assert_test()"]
        CLI["deepeval test run"]
        IT["evals_iterator()"]
        CMP["compare()"]
    end

    G["CI"]
    REP["TestRun JSON<br>+ Confident AI report"]

    SYN --> A
    SIM --> CG
    ED -.-> A
    ED -.-> CG
    A --> B
    CG --> B
    B --> C
    B --> CTC
    B -.-> OBS
    C --> BM
    CTC --> BCM
    CTC --> BVM
    ATC --> BAM
    C --> CLS
    OBS -.-> BM
    BM --> E
    BCM --> E
    BVM --> E
    BAM --> WIN
    CLS --> LBL["Label from a closed set"]
    JUDGE -.-> E
    E --> F
    F --> G
    F --> REP
    EV -.-> BM
    EV -.-> BCM
    IT -.-> BM
    CLI -.-> EV
    CMP -.-> BAM

